<Application
    x:Class="ClickToPDF.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!-- The surface palette and IconButtonStyle are shared by every Bureau app and live in
                 the Bureau.Common submodule (external/Bureau.Common). Edit them there, not here. -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="ms-appx:///Bureau.Common/Themes/Palette.xaml"/>
                <ResourceDictionary Source="ms-appx:///Bureau.Common/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
